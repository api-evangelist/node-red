{
  "opencollection": "1.0.0",
  "info": {
    "name": "Node-RED Admin Auth Diagnostics API",
    "version": "4.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Diagnostics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the runtime diagnostics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:{port}/diagnostics"
          },
          "docs": "Get the runtime diagnostics"
        }
      ]
    }
  ],
  "bundled": true
}